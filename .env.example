# ─── Mermaid API Environment Variables ──────────────────────────────────────
# Copy this file to .env and customize.

# Port the server listens on (Railway sets this automatically)
PORT=8080

# Node environment
NODE_ENV=production

# Chromium binary path (auto-detected from system install by default)
CHROMIUM_PATH=/usr/bin/chromium

# Maximum concurrent browser instances (default: 4)
MAX_CONCURRENT=4
